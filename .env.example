# ─────────────────────────────────────────────────────────────
# VulPortal 환경변수 예시
# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채우세요.
# .env.local 은 .gitignore 에 포함되어 있어 저장소에 올라가지 않습니다.
# ─────────────────────────────────────────────────────────────

# [공통] Databricks 워크스페이스 주소 (https:// 포함, 끝에 / 없이)
DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net

# [공통] SQL Warehouse ID (SQL Warehouses > 해당 웨어하우스 > Connection details 의 HTTP path 마지막 부분)
DATABRICKS_WAREHOUSE_ID=0123456789abcdef

# [공통] 테이블을 만들 Unity Catalog 카탈로그/스키마 이름
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=vuln_portal

# [로컬 개발 전용] 개인 액세스 토큰(PAT). 운영(Databricks Apps)에서는 사용하지 않습니다.
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [운영 전용] Databricks Apps 가 자동으로 주입하므로 직접 설정하지 않습니다.
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# DATABRICKS_APP_PORT=

# [로컬 개발 전용] 로그인 사용자 대체값. 운영 빌드(NODE_ENV=production)에서는 무시됩니다.
DEV_USER_EMAIL=admin@example.com

# [공통] 취약점 수집 Job ID (Databricks > Workflows > vulportal_sync_vuln 의 Job ID). 비우면 "지금 수동 실행" 버튼이 꺼집니다.
SYNC_JOB_ID=

# [공통] 최초 관리자 이메일. users 테이블이 비어 있을 때 이 이메일을 관리자로 등록합니다.
INITIAL_ADMIN_EMAIL=admin@example.com
